-- ========== PERSONAGEM QUE O JOGADOR ESTÁ USANDO ==========
-- Tira acento, espaço, hífen e maiúsculas para comparar nomes
local function normalizar(txt)
	txt = string.lower(tostring(txt))
	local mapa = {
		["á"] = "a", ["à"] = "a", ["â"] = "a", ["ã"] = "a", ["é"] = "e", ["ê"] = "e",
		["í"] = "i", ["ó"] = "o", ["ô"] = "o", ["õ"] = "o", ["ú"] = "u", ["ç"] = "c",
		["Á"] = "a", ["Â"] = "a", ["Ã"] = "a", ["É"] = "e", ["Ê"] = "e", ["Í"] = "i",
		["Ó"] = "o", ["Ô"] = "o", ["Õ"] = "o", ["Ú"] = "u", ["Ç"] = "c",
	}
	for k, v in pairs(mapa) do txt = txt:gsub(k, v) end
	return (txt:gsub("[^%w]", ""))
end

for _, pers in ipairs(PERSONAGENS) do
	pers.aliasN = {}
	for _, a in ipairs(pers.alias) do table.insert(pers.aliasN, normalizar(a)) end
end

-- Procura um personagem dentro de um texto (nome ou ID da figura)
local function acharPersonagem(texto)
	for _, pers in ipairs(PERSONAGENS) do
		if pers.icone and string.find(texto, pers.icone, 1, true) then return pers end
	end
	local n = normalizar(texto)
	if n == "" then return nil end
	local melhor, tam = nil, 0
	for _, pers in ipairs(PERSONAGENS) do
		for _, a in ipairs(pers.aliasN) do
			if (n == a) or (#a >= 5 and string.find(n, a, 1, true))
				or (#a == 4 and string.sub(n, 1, 4) == a) then
				if #a > tam then melhor, tam = pers, #a end
			end
		end
	end
	return melhor
end

-- Junta tudo que o jogo guarda do jogador e do personagem dele (textos, valores, atributos)
local function coletarTextos(plr)
	local textos = {}
	local function add(t)
		if type(t) == "string" and t ~= "" and #t <= 120 then table.insert(textos, t) end
	end
	local function atributos(obj)
		local ok, attrs = pcall(function() return obj:GetAttributes() end)
		if not ok then return end
		for k, v in pairs(attrs) do
			if type(v) == "string" then
				add(v)
			elseif type(v) == "number" then
				add(string.format("%.0f", v))
			elseif v == true then
				add(k)
			end
		end
	end

	atributos(plr)
	for _, filho in ipairs(plr:GetChildren()) do
		if filho.Name ~= "PlayerGui" then
			if filho:IsA("Tool") then add(filho.Name) end
			atributos(filho)
			for _, d in ipairs(filho:GetDescendants()) do
				if d:IsA("StringValue") then
					add(d.Value)
				elseif d:IsA("ObjectValue") then
					add(d.Value and d.Value.Name)
				elseif d:IsA("IntValue") or d:IsA("NumberValue") then
					add(string.format("%.0f", d.Value))
				elseif d:IsA("BoolValue") and d.Value then
					add(d.Name)
				end
				atributos(d)
			end
		end
	end

	local char = plr.Character
	if char then
		atributos(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then atributos(hum) end
		for _, filho in ipairs(char:GetChildren()) do
			if not filho:IsA("BasePart") then add(filho.Name) end
		end
	end
	return textos
end

local function descobrirPersonagem(plr)
	local ok, textos = pcall(coletarTextos, plr)
	if not ok or type(textos) ~= "table" then return nil end
	for _, t in ipairs(textos) do
		local pers = acharPersonagem(t)
		if pers then return pers end
	end
	return nil
end

