	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if Util.amigos[plr.UserId] then criarCartaoAmigo(plr) end
	end
	ligar(Players.PlayerRemoving, function(plr)
		local c = cartoesA[plr]
		if c then
			c.cel:Destroy()
			cartoesA[plr] = nil
		end
		if seg.plr == plr then
			seg.plr = nil
			seg.ligado = false
		end
		atualizar()
	end)

	-- anda ao lado do amigo (todo frame). Desliga sozinho se um modo de farm for ligado.
	local function pinar()
		if not (seg.ligado and seg.plr) then return end
		if randomOn or nearOn or target then
			seg.ligado = false
			avisar("Seguir desligado: um modo de farm foi ligado.")
			return
		end
		local char = LocalPlayer.Character
		local meu = getHRP(char)
		local alvo = getHRP(seg.plr.Character)
		if not meu or not alvo then return end
		-- lado do amigo na horizontal (ignora inclinação do corpo dele)
		local olhar = alvo.CFrame.LookVector
		olhar = Vector3.new(olhar.X, 0, olhar.Z)
		if olhar.Magnitude < 0.1 then olhar = Vector3.new(0, 0, -1) end
		olhar = olhar.Unit
		local direita = olhar:Cross(Vector3.new(0, 1, 0))
		local lado = (seg.lado == "esquerdo") and -1 or 1
		local pos = alvo.Position + direita * (3.5 * lado)

		-- nunca debaixo da terra: se o ponto ficar abaixo do chão, sobe para cima dele
		raioParams.FilterDescendantsInstances = {char, seg.plr.Character}
		local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -30, 0), raioParams)
		if hit then
			local minimo = hit.Position.Y + BASE_SEGURA.pes
			if pos.Y < minimo then pos = Vector3.new(pos.X, minimo, pos.Z) end
		end

		char:PivotTo(CFrame.lookAt(pos, pos + olhar))
		meu.AssemblyLinearVelocity = Vector3.zero
	end
	ligar(RunService.Heartbeat, pinar)
	ligar(RunService.RenderStepped, pinar)

	atualizar()
end)

