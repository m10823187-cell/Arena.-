	local cartoesF = {} -- [plr] = {cel, btn, quad}

	repintar = function()
		local foco = Util.foco
		for plr, c in pairs(cartoesF) do
			local focado = (foco.plr == plr)
			c.btn.Text = focado and "FOCADO" or "FOCAR"
			c.btn.BackgroundColor3 = focado and COR.on or COR.roxo
			c.quad.BorderColor3 = focado and COR.on or (ehAdm(plr) and COR.ouro or COR.azul)
		end
		local texto
		if foco.plr then
			local nome = foco.plr.DisplayName
			local hrp = getHRP(foco.plr.Character)
			if not foco.ligado then
				texto = "🎯 " .. nome .. " está marcado, mas a função de focar está desligada."
			elseif hrp and noLobby(hrp.Position) then
				texto = "🎯 Focando " .. nome .. " (no lobby: esperando ele sair)."
			else
				texto = "🎯 Focando " .. nome .. "."
			end
		else
			texto = "Ninguém focado."
		end
		statusFoco.Text = texto
		statusAtq.Text = texto
	end

	tirarBtn.MouseButton1Click:Connect(function()
		Util.foco.plr = nil
		repintar()
	end)

	local function criarCartaoF(plr)
		if plr == LocalPlayer or cartoesF[plr] then return end
		local adm = ehAdm(plr)
		local cel = criar("Frame", {Name = plr.Name, BackgroundTransparency = 1}, grade)
		local quad = criar("Frame", {
			Size = UDim2.new(1, 0, 0, CARD.altura),
			BackgroundColor3 = COR.card,
			BorderSizePixel = CARD.borda,
			BorderMode = Enum.BorderMode.Inset,
			BorderColor3 = adm and COR.ouro or COR.azul,
		}, cel)
		local foto = criar("ImageLabel", {
			Size = UDim2.new(0, CARD.foto, 0, CARD.foto),
			Position = UDim2.new(0.5, -CARD.foto / 2, 0, 4),
			BackgroundColor3 = COR.fundo,
			BorderSizePixel = 0,
			Image = "",
		}, quad)
		carregarFoto(plr, foto)
		local nome = criar("TextLabel", {
			Size = UDim2.new(1, -4, 0, CARD.altura - CARD.foto - 9),
			Position = UDim2.new(0, 2, 0, CARD.foto + 6),
			BackgroundTransparency = 1,
			Text = textoNome(plr),
			TextColor3 = COR.texto,
			TextScaled = true,
			Font = Enum.Font.SourceSansBold,
		}, quad)
		criar("UITextSizeConstraint", {MaxTextSize = 10}, nome)

		local btn = criar("TextButton", {
			Size = UDim2.new(1, 0, 0, CARD.botao),
			Position = UDim2.new(0, 0, 0, CARD.altura + 3),
			BackgroundColor3 = COR.roxo,
			BorderSizePixel = 0,
			Text = "FOCAR",
			TextColor3 = COR.texto,
			TextSize = 10,
			Font = Enum.Font.SourceSansBold,
			AutoButtonColor = false,
		}, cel)
		btn.MouseButton1Click:Connect(function()
			Som.tocar("clique")
			if Util.foco.plr == plr then
				Util.foco.plr = nil -- tocou de novo: tira o foco
			else
				Util.foco.plr = plr
				-- o modo automático passa a pegar só no focado
				if Util.foco.ligado and target and target ~= plr and (randomOn or nearOn) then
					target = nil
				end
			end
			repintar()
		end)
		cartoesF[plr] = {cel = cel, btn = btn, quad = quad}
	end

	for _, plr in ipairs(Players:GetPlayers()) do criarCartaoF(plr) end
	ligar(Players.PlayerAdded, function(plr)
		criarCartaoF(plr)
		repintar()
	end)
	ligar(Players.PlayerRemoving, function(plr)
		local c = cartoesF[plr]
		if c then
			c.cel:Destroy()
			cartoesF[plr] = nil
		end
		if Util.foco.plr == plr then Util.foco.plr = nil end
		repintar()
	end)
	repintar()

	-- atualiza a situação (lobby / saiu do lobby) a cada segundo
	while vivo and task.wait(1) do
		if Util.foco.plr then repintar() end
	end
end)

