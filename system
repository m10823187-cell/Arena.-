-- Mostra o personagem: a figura quando tem ID, senão o título
local aplicarPersonagem
do
	local cacheDecal = {}

	-- Se o ID for de "Decal", descobre o ID da imagem que está dentro dele
	local function resolverDecal(id)
		id = idTexto(id)
		if cacheDecal[id] ~= nil then return cacheDecal[id] or nil end
		local ok, tex = pcall(function()
			local objs = game:GetObjects("rbxassetid://" .. id)
			local o = objs and objs[1]
			if not o then return nil end
			if o:IsA("Decal") or o:IsA("Texture") then return o.Texture end
			local d = o:FindFirstChildWhichIsA("Decal", true)
			return d and d.Texture or nil
		end)
		cacheDecal[id] = (ok and tex and tex ~= "") and tex or false
		return cacheDecal[id] or nil
	end

	-- Mostra o personagem: a figura quando tem ID, senão o título.
	-- A figura é insistente: se não carregar, troca de formato a cada 3 segundos
	-- (miniatura, imagem direta, Decal) até carregar. Enquanto isso o título fica à mostra.
	aplicarPersonagem = function(c, pers)
		local chave = pers and pers.nome or "?"
		if c.persChave == chave then return end
		c.persChave = chave
		if pers and pers.icone then
			c.tituloLbl.Text = pers.nome
			c.tituloLbl.Visible = true
			c.iconeImg.Image = miniatura(pers.icone, 150)
			c.iconeImg.Visible = true
			task.spawn(function()
				local formato, desde = 1, os.clock()
				while c.persChave == chave and c.iconeImg.Parent do
					if c.iconeImg.IsLoaded and c.iconeImg.Image ~= "" then
						c.tituloLbl.Visible = false
						return
					end
					if os.clock() - desde > (formato == 1 and 3 or 2) then
						desde = os.clock()
						formato = formato % 3 + 1
						if formato == 1 then
							c.iconeImg.Image = miniatura(pers.icone, 150)
						elseif formato == 2 then
							c.iconeImg.Image = "rbxassetid://" .. idTexto(pers.icone)
						else
							local tex = resolverDecal(pers.icone)
							if tex then c.iconeImg.Image = tex end
						end
					end
					task.wait(0.25)
				end
			end)
		else
			c.iconeImg.Visible = false
			c.tituloLbl.Text = pers and pers.nome or "?"
			c.tituloLbl.Visible = true
		end
	end
end

