-- Motivo pelo qual o jogador NÃO pode ser farmado (nil = pode)
local function motivoInvalido(plr)
	if not plr or plr == LocalPlayer then return "invalido" end
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = getHRP(char)
	if not hum or not hrp then return "saiu" end
	if hum.Health <= 0 then return "morto" end
	if noLobby(hrp.Position) then return "lobby" end
	if hrp.Position.Y < CONFIG.VOID_Y then return "void" end
	return nil
end

local function isValid(plr)
	return motivoInvalido(plr) == nil
end

-- Escolhe um alvo nos modos automáticos
local function escolherAlvo(hrp)
	-- Focando alguém: o modo escolhido só pega nele, em qualquer distância.
	-- Se ele estiver no lobby (ou morto/no void), não pega ninguém e espera.
	local foco = Util.foco
	if foco.ligado and foco.plr then
		if isValid(foco.plr) then return foco.plr end
		return nil
	end

	local lista = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if isValid(p) and podeFarmarAuto(p) then
			table.insert(lista, p)
		end
	end
	if #lista == 0 then return nil end

	if randomOn then
		return lista[math.random(#lista)]
	end

	-- próximo: o mais perto dentro do raio
	local melhor, dist = nil, CONFIG.NEAR_RADIUS
	for _, p in ipairs(lista) do
		local d = (getHRP(p.Character).Position - hrp.Position).Magnitude
		if d < dist then melhor, dist = p, d end
	end
	return melhor
end

-- Cola em você no alvo (pelos pés): move o corpo INTEIRO e zera a velocidade.
-- Roda em 3 momentos por frame (antes da física, depois e antes de desenhar)
-- para o personagem não aparecer em outros lugares
local function seguirAlvo(char, hrp)
	local th = target and getHRP(target.Character)
	if not th then return end
	char:PivotTo(CFrame.new(th.Position + Vector3.new(0, CONFIG.OFFSET_Y, 0)))
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end

-- Um passo do farm (todo frame). Funciona até se você estiver no lobby:
-- ao ligar o farm você vai direto para o alvo
local function farmar(hrp)
	-- Focando alguém com um modo de farm ligado: troca para o jogador focado assim que ele for válido
	local foco = Util.foco
	if foco.ligado and foco.plr and (randomOn or nearOn) and target ~= foco.plr and isValid(foco.plr) then
		target = foco.plr
		refresh()
	end

	if target then
		local motivo = motivoInvalido(target)
		if motivo then
			local th = getHRP(target.Character)
			local pos = (th and th.Position) or ultimaPosAlvo
			target = nil
			local char = hrp.Parent
			local hum = char:FindFirstChildOfClass("Humanoid")
			if motivo == "void" then
				-- alvo caiu no void: volta para a última parte do mapa
				if hum then voltarAoChao(char, hum) end
			elseif motivo == "morto" and tpAoMatar then
				-- opção ligada: vai para a posição salva
				char:PivotTo(CFrame.new(posSalva))
				hrp.AssemblyLinearVelocity = Vector3.zero
			elseif pos then
				-- opção desligada: sai de baixo da terra e fica em cima do mapa
				char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			refresh()
			return
		end
		ultimaPosAlvo = getHRP(target.Character).Position
		seguirAlvo(hrp.Parent, hrp)
		return
	end

	if (randomOn or nearOn) and os.clock() >= proximaBusca then
		proximaBusca = os.clock() + 0.25
		target = escolherAlvo(hrp)
		if target then refresh() end
	end
end

-- Liga/desliga o farm manual em um jogador (3 toques no quadrado)
local function alternarFarm(plr)
	if target == plr then
		target = nil
	elseif isValid(plr) then
		target = plr
	end
	refresh()
end

