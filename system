-- Guarda a conexão para poder desligar tudo ao fechar o menu
local function ligar(sinal, fn)
	local c = sinal:Connect(fn)
	table.insert(conexoes, c)
	return c
end

-- Cria uma instância já com propriedades e pai
local function criar(classe, props, pai)
	local obj = Instance.new(classe)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = pai
	return obj
end

local function arredondar(obj, raio)
	criar("UICorner", {CornerRadius = UDim.new(0, raio or 8)}, obj)
end

-- Sons do menu: "carregou" toca quando a barra de carregamento termina; "clique" ao apertar botões
local Som = {ids = {carregou = "140207837688369", clique = "105197111717033"}, cache = {}}

function Som.obter(nome)
	local snd = Som.cache[nome]
	if snd and snd.Parent then return snd end
	local id = Som.ids[nome]
	if not id then return nil end
	snd = Instance.new("Sound")
	snd.Name = "Arena_" .. nome
	snd.SoundId = "rbxassetid://" .. id
	snd.Volume = 1
	snd.Parent = game:GetService("SoundService")
	Som.cache[nome] = snd
	return snd
end

function Som.tocar(nome)
	pcall(function()
		local snd = Som.obter(nome)
		if snd then
			snd.TimePosition = 0
			snd:Play()
		end
	end)
end

function Som.preparar() -- baixa os sons antes de precisar (sem atraso no primeiro toque)
	local lista = {}
	for nome in pairs(Som.ids) do
		local snd = Som.obter(nome)
		if snd then table.insert(lista, snd) end
	end
	pcall(function() game:GetService("ContentProvider"):PreloadAsync(lista) end)
end

function Som.limpar()
	for _, snd in pairs(Som.cache) do pcall(function() snd:Destroy() end) end
	Som.cache = {}
end

-- Tempo em texto: "12 s", "5 min 30 s", "2 h 15 min", "1 dia 3 h"
local Util = {}
function Util.tempo(seg)
	seg = math.max(0, math.floor(seg))
	if seg < 60 then return seg .. " s" end
	local m = math.floor(seg / 60)
	if m < 60 then return m .. " min " .. (seg % 60) .. " s" end
	local h = math.floor(m / 60)
	if h < 24 then return h .. " h " .. (m % 60) .. " min" end
	local d = math.floor(h / 24)
	return d .. (d == 1 and " dia " or " dias ") .. (h % 24) .. " h"
end

