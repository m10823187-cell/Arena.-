			arredondar(c, 8)
			return c
		end
		chip(1, "📅 " .. os.date("%d/%m/%Y", t.entrada))
		chip(2, "🕒 " .. os.date("%H:%M:%S", t.entrada))
		local tempo = chip(3, "⏱ " .. Util.tempo((t.ultima or t.entrada) - t.entrada), COR.ouro)
		local contagem = chip(4, "👥 " .. #t.jogadores, COR.verde)

		-- Corpo: duas colunas com uma linha no meio
		local caixa = criar("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			BackgroundTransparency = 1,
		}, painel)
		criar("Frame", {
			Size = UDim2.new(0, 1, 1, 0),
			Position = UDim2.new(0.5, 0, 0, 0),
			BackgroundColor3 = COR.cinza,
			BorderSizePixel = 0,
		}, caixa)
		local corpo = criar("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, caixa)
		criar("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 46),
			CellPadding = UDim2.new(0, 8, 0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}, corpo)

		local ui = {tabela = t, painel = painel, corpo = corpo, tempo = tempo, contagem = contagem, linhas = {}, porId = {}}
		uis[t] = ui
		for _, jog in ipairs(t.jogadores) do adicionarLinha(ui, jog) end

		remover.MouseButton1Click:Connect(function()
			Som.tocar("clique")
			for i, x in ipairs(dados.tabelas) do
				if x == t then table.remove(dados.tabelas, i) break end
			end
			if atual == t then atual = nil end -- tabela removida: não grava mais nela
			painel:Destroy()
			uis[t] = nil
			salvarAgora()
			aplicarFiltro()
		end)
	end

	repintarId = function(id)
		for _, ui in pairs(uis) do
			local l = ui.porId[id]
			if l then atualizarLinha(l) end
		end
	end

	-- Manda o jogador para a lista negra (guarda foto, nome, dia, hora e tabela)
	adicionarNegra = function(t, jog)
		if not t or not jog then return end
		local nome = jog.exibicao or jog.nome
		if negraPorId[jog.id] then
			txtNegra.Text = "⚠️ " .. nome .. " já está na lista negra."
			return
		end
		local e = {
			id = jog.id, nome = jog.nome, exibicao = jog.exibicao,
			tabela = t.num, dia = diaDe(t), servidor = t.entrada,
			entrou = jog.entrou, saiu = jog.saiu, em = os.time(),
		}
		table.insert(dadosNegra, e)
		negraPorId[jog.id] = e
		salvarNegra()
		reconstruirNegra()
		repintarId(jog.id)
		txtNegra.Text = "⛔ " .. nome .. " foi para a lista negra."
	end

	selecionarBtn.MouseButton1Click:Connect(function()
		modoSel = not modoSel
		selecionarRotulo.Text = modoSel and "✅ Selecionando… toque num jogador"
			or "Selecionar jogadores (lista negra)"
		txtNegra.Text = modoSel and "Toque num jogador de qualquer tabela para mandar para a lista negra. Toque no botão de novo para parar." or ""
		for _, ui in pairs(uis) do
			for _, l in ipairs(ui.linhas) do atualizarLinha(l) end
		end
	end)

	verNegraBtn.MouseButton1Click:Connect(function()
		painelNegra.Visible = not painelNegra.Visible
		atualizarRotuloNegra()
	end)

	limparNegraBtn.MouseButton1Click:Connect(function()
		local ids = {}
		for _, e in ipairs(dadosNegra) do table.insert(ids, e.id) end
		dadosNegra = {}
		negraPorId = {}
		salvarNegra()
		reconstruirNegra()
		for _, id in ipairs(ids) do repintarId(id) end
	end)

	for _, t in ipairs(dados.tabelas) do criarTabelaUI(t) end
	reconstruirNegra()
	aplicarFiltro()

	removerTodasBtn.MouseButton1Click:Connect(function()
		for _, ui in pairs(uis) do ui.painel:Destroy() end
		uis = {}
		dados.tabelas = {}
		atual = nil
		salvarAgora()
		aplicarFiltro()
	end)

	-- ---- jogadores entrando e saindo (quem sai continua na tabela) ----
	local function registrarJogador(plr)
		if not atual then return end
		local ui = uis[atual]
		local jog
		for _, j in ipairs(atual.jogadores) do
			if j.id == plr.UserId then jog = j break end
		end
		if jog then
			jog.saiu = nil
			if ui and ui.porId[jog.id] then atualizarLinha(ui.porId[jog.id]) end
		else
			jog = {id = plr.UserId, nome = plr.Name, exibicao = plr.DisplayName, entrou = os.time()}
			table.insert(atual.jogadores, jog)
			if ui then adicionarLinha(ui, jog) end
		end
		sujo = true
	end

	ligar(Players.PlayerAdded, registrarJogador)
	ligar(Players.PlayerRemoving, function(plr)
		if not atual then return end
		for _, j in ipairs(atual.jogadores) do
			if j.id == plr.UserId then
				j.saiu = os.time()
				local ui = uis[atual]
				if ui and ui.porId[j.id] then atualizarLinha(ui.porId[j.id]) end
				break
			end
		end
		sujo = true
	end)
	for _, plr in ipairs(Players:GetPlayers()) do registrarJogador(plr) end
	sujo = true

	-- ---- botão da barra (só aparece em CONFIGURAÇÃO e SERVIDORES) ----
	local btn = botaoBarra("🗂️", UDim2.new(1, -133, 0, 4), COR.roxo)
	btn.Name = "BtnServidores"
	btn.Visible = false
	iconeBarra(btn, "livros", "🗂️")
	btn.MouseButton1Click:Connect(function()
		if minimizado then definirMinimizado(false) end
		mostrarPagina("servidores")
	end)

	-- botão de voltar: um só para o menu inteiro, SEMPRE o último da barra.
	-- Leva para a página mãe (veja Util.PAI) e aparece em toda página que não seja a principal.
	local voltar = botaoBarra("←", UDim2.new(1, -155, 0, 4), COR.cinza)
	voltar.Name = "BtnVoltar"
	voltar.Visible = false
	iconeBarra(voltar, "seta_esquerda", "←")
	voltar.MouseButton1Click:Connect(function()
		if minimizado then definirMinimizado(false) end
		mostrarPagina(Util.PAI[paginaAtual] or "menu")
	end)

	-- ---- relógio: tempo no servidor ao vivo + salvamento automático ----
	local n = 0
	while vivo and task.wait(1) do
		n = n + 1
		if atual then
			atual.ultima = os.time()
			local ui = uis[atual]
			if ui and lista.Visible then
				ui.tempo.Text = "⏱ " .. Util.tempo(atual.ultima - atual.entrada)
			end
		end
		if sujo or n % 15 == 0 then
			sujo = false
			salvarAgora()
		end
	end
end)

-- ========== SERVIDOR MAIS VAZIO (em desenvolvimento) ==========
-- O Roblox não deixa criar um servidor público novo e vazio (só o próprio jogo cria).
-- O botão procura, na lista de servidores públicos, o que tem MENOS jogadores e entra nele.
task.spawn(function()
	local TeleportService = game:GetService("TeleportService")

	local conteudo = novoPainel(listaAjustes, 5, "Trocar de servidor", COR.laranja, "foguete", "🚀")
	local btn = novoBotao(1, conteudo, "Ir para o servidor mais vazio", COR.laranja, "foguete", "🚀")
	local info = novoTexto(2, conteudo,
		"🚧 Em desenvolvimento. Procura o servidor público com menos jogadores e entra nele. "
		.. "Não dá para criar um servidor novo vazio: o Roblox só deixa o próprio jogo criar.", 100)

	local procurando = false
	btn.MouseButton1Click:Connect(function()
		if procurando then return end
		procurando = true
		info.Text = "🔎 Procurando servidores públicos..."

		task.spawn(function()
			local melhor = nil
			local ok = pcall(function()
				local cursor = nil
				for _ = 1, 3 do -- até 3 páginas (300 servidores), do mais vazio para o mais cheio
					local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
						.. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
						.. (cursor and ("&cursor=" .. cursor) or "")
					local resp = HttpService:JSONDecode(game:HttpGet(url))
					for _, sv in ipairs(resp.data or {}) do
						if sv.id ~= game.JobId and sv.playing < sv.maxPlayers then
							if not melhor or sv.playing < melhor.playing then melhor = sv end
						end
					end
					if melhor and melhor.playing <= 1 then break end
					cursor = resp.nextPageCursor
					if not cursor then break end
				end
			end)

			if not ok then
				info.Text = "❌ A lista de servidores não abriu (seu executor pode estar bloqueando). Tente de novo."
				procurando = false
				return
			end
			if not melhor then
				info.Text = "❌ Não achei outro servidor disponível agora."
				procurando = false
				return
			end

			info.Text = "✅ Achei um servidor com " .. melhor.playing .. "/" .. melhor.maxPlayers
				.. " jogadores. Teleportando..."

			-- Reabre o menu sozinho no servidor novo (se o executor permitir)
			local fila = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
			if fila and CONFIG.URL_SCRIPT and CONFIG.URL_SCRIPT ~= "" then
				pcall(fila, 'loadstring(game:HttpGet("' .. CONFIG.URL_SCRIPT .. '"))()')
			end

			local okTp, errTp = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, melhor.id, LocalPlayer)
			end)
			if not okTp then
				info.Text = "❌ O jogo não deixou teleportar: " .. tostring(errTp)
			end
			task.wait(6)
			procurando = false
		end)
	end)
end)

